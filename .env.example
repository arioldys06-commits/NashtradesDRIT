# --- Cuenta MT5 (XMGlobal nueva, DISTINTA a la de TradingProEA) ---
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
MT5_PATH=C:\XM Global MT5\terminal64.exe

# --- Supabase (proyecto NUEVO y separado del de TradingProEA) ---
SUPABASE_URL=
SUPABASE_KEY=
# service_role — SOLO para el backend Python, NUNCA para el dashboard/frontend.
# Sacala en: https://supabase.com/dashboard/project/<tu-project-ref>/settings/api-keys
SUPABASE_SERVICE_KEY=

# --- Telegram (canal propio de NashtradesDRIT, crear uno nuevo) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News engine (calendario ForexFactory + Alpha Vantage + sesgo Claude) ---
# Alpha Vantage: gratis en https://www.alphavantage.co/support/#api-key
# Anthropic: gratis/de pago en https://console.anthropic.com — NO es lo mismo
# que tu suscripcion de claude.ai, es una API key aparte para uso programatico
ALPHA_VANTAGE_API_KEY=
ANTHROPIC_API_KEY=

# --- Timezone ---
LOCAL_TZ=America/Santo_Domingo

# --- Identificación del bot ---
MAGIC_NUMBER=20260901
SYMBOL=GOLD
EURUSD_SYMBOL=EURUSD

# --- Riesgo global (bot_engine.py) ---
MAX_TRADES_PER_DAY=3
MAX_DAILY_LOSSES=2
# Techo de lote (el lote se calcula por % de riesgo y nunca pasa de este valor). 0 = sin techo
FIXED_LOT=0.01
